/* Ryoku Appearance Engine — Rofi RASI adapter (dark).
 * Generated by Matugen via DMS. Same tokens as palette.json / palette.css. */
* {
    ryoku-primary: {{colors.primary.default.hex}};
    ryoku-on-primary: {{colors.on_primary.default.hex}};
    ryoku-surface: {{colors.surface.default.hex}};
    ryoku-surface-container: {{colors.surface_container.default.hex}};
    ryoku-surface-container-high: {{colors.surface_container_high.default.hex}};
    ryoku-on-surface: {{colors.on_surface.default.hex}};
    ryoku-outline: {{colors.outline.default.hex}};
    ryoku-error: {{colors.error.default.hex}};
}
